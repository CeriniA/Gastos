# Copy to frontend/.env for local development. In Render this goes in the
# static site's Environment tab. It is baked in at build time and is public.

# Origin of the backend, no trailing slash and no /api/v1.
VITE_API_URL=http://localhost:4000

# The address users can write to about their data. Shown on the privacy policy
# and the terms, which anybody can read. Leave empty to show none.
VITE_CONTACT_EMAIL=
