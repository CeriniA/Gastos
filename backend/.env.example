# Copy to backend/.env for local development. In Render these go in the
# service's Environment tab. Never commit real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Use one database for your real data and a
# different one (e.g. gastos-dev) while developing.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gastos-dev?retryWrites=true&w=majority

# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# The first user of the app, an administrator, created the first time the
# server starts. After that, users and passwords are managed from the app
# (Más → Usuarios, Más → Cambiar mi contraseña) and these two are not read again.
# Generate the hash with:
#   npm run hash-password -w backend -- "your password"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Exact origin of the frontend, no trailing slash. Several can be comma-separated.
CORS_ORIGIN=http://localhost:5173

APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# AI reading of receipts and screenshots. Get a key at https://aistudio.google.com
# (Get API key). Leave empty to keep the feature off.
GEMINI_API_KEY=
# Which Gemini model reads the documents. Compare models on your own documents
# with: npm run try-extraction -w backend -- <folder>
GEMINI_MODEL=gemini-3.5-flash-lite

# Automatic backup to Google Drive, once a day while the app is in use. These
# are the app's credentials, set once; each user then connects their own Drive
# from the app (Más → Respaldo y datos). Follow docs/RESPALDO_DRIVE.md.
# Leave empty to keep the feature off.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
# This backend's own public address, no trailing slash: Google sends users back
# to it. Locally, http://localhost:4000
PUBLIC_API_URL=
