# Copy to backend/.env for local development. In Render these go in the
# service's Environment tab. Never commit real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Use one database for your real data and a
# different one (e.g. gastos-dev) while developing.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gastos-dev?retryWrites=true&w=majority

# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# The single user of the app. Generate the hash with:
#   npm run hash-password -w backend -- "your password"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Exact origin of the frontend, no trailing slash. Several can be comma-separated.
CORS_ORIGIN=http://localhost:5173

APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# Stage 2 (AI extraction). Leave empty until then.
GEMINI_API_KEY=
