# Made-up values for running the backend in memory: the HTTP tests (npm test)
# and the demo server (npm run demo). Nothing here is a real secret and no
# database is ever contacted. Never put real values in this file.

NODE_ENV=test
PORT=4000
MONGODB_URI=mongodb://not-used.invalid/gastos-memory
JWT_SECRET=memory-only-secret-not-used-anywhere-real-0123456789
JWT_EXPIRES_DAYS=30

# The first user, an admin: "demo", password "demo". The demo and the tests
# create the rest from the app.
AUTH_USERNAME=demo
AUTH_PASSWORD_HASH=$2b$10$oLi5Z//ok6IOtfYstob2xOYJ9QnrM6LzrJTMXvdfRmaU9AZ9EfMyK

CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=silent

# Kept empty so a real backend/.env next to this file cannot switch them on.
GEMINI_API_KEY=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
PUBLIC_API_URL=
